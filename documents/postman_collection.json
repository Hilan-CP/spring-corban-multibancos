                "exec": [
                  "// Captura o token do header Authorization\nconst authHeader = pm.response.headers.get('Authorization');\n\nif (authHeader) {\n    // Remove o prefixo 'Bearer ' se existir\n    const token = authHeader.startsWith('Bearer ') ? authHeader.substring(7) : authHeader;\n    pm.environment.set('token', token);\n    console.log('Token salvo na variável de ambiente \"token\" com sucesso.');\n} else {\n    // Tenta capturar do body como fallback\n    try {\n        const jsonBody = pm.response.json();\n        if (jsonBody && jsonBody.access_token) {\n            pm.environment.set('token', jsonBody.access_token);\n            console.log('Token (access_token) salvo na variável de ambiente \"token\" com sucesso.');\n        } else {\n            console.log('Token não encontrado no header Authorization nem no body da resposta.');\n        }\n    } catch (e) {\n        console.log('Token não encontrado no header Authorization e o body não é JSON válido.');\n    }\n}"
                ]
